+#include <stdlib.h>
+#include <stdint.h>
+
+static uint64_t rotr64_safe(uint64_t x, unsigned int n)
+{
+    n &= 63u;
+    return n ? ((x >> n) | (x << (64u - n))) : x;
+}
+
+static uint32_t rotr32_safe(uint32_t x, unsigned int n)
+{
+    n &= 31u;
+    return n ? ((x >> n) | (x << (32u - n))) : x;
+}
+
+#define ROTR64(x,n) rotr64_safe((uint64_t)(x), (unsigned int)(n))
+#define ROTR32(x,n) rotr32_safe((uint32_t)(x), (unsigned int)(n))
