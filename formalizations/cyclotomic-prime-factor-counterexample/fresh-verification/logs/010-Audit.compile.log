def CyclotomicCounterexample.F : Polynomial ℤ :=
(Polynomial.cyclotomic 4 ℤ * Polynomial.cyclotomic 9 ℤ * Polynomial.cyclotomic 25 ℤ * Polynomial.cyclotomic 30 ℤ) ^ 6
def CyclotomicCounterexample.IsBasicCGF : Polynomial ℤ → Prop :=
fun f => CyclotomicCounterexample.NonnegativeCoeffs f ∧ CyclotomicCounterexample.IsCyclotomicProduct f
def CyclotomicCounterexample.IsCyclotomicProduct : Polynomial ℤ → Prop :=
fun f => ∃ s m, (∀ n ∈ s, 2 ≤ n) ∧ f = ∏ n ∈ s, Polynomial.cyclotomic n ℤ ^ m n
def CyclotomicCounterexample.UnimodalCoeffs : Polynomial ℤ → Prop :=
fun f =>
  ∃ peak,
    (∀ (i j : ℕ), i ≤ j → j ≤ peak → f.coeff i ≤ f.coeff j) ∧ ∀ (i j : ℕ), peak ≤ i → i ≤ j → f.coeff j ≤ f.coeff i
def CyclotomicCounterexample.Conjecture48 : Prop :=
∀ (f : Polynomial ℤ),
  CyclotomicCounterexample.IsBasicCGF f →
    CyclotomicCounterexample.UnimodalCoeffs f → f ≠ 1 → ∃ p, Nat.Prime p ∧ Polynomial.cyclotomic p ℤ ∣ f
