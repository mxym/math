import SymmetricSupport.Occupation
import Mathlib.Algebra.MvPolynomial.Funext
import Mathlib.Data.Finsupp.Multiset
import Mathlib.LinearAlgebra.Dual.Lemmas

open scoped BigOperators
open Matrix

namespace SymmetricSupport

noncomputable section

def occupationExponent {D k : ℕ} (s : Sym (Fin D) k) : Fin D →₀ ℕ :=
  s.val.toFinsupp

theorem occupationExponent_injective (D k : ℕ) :
    Function.Injective (@occupationExponent D k) := by
  intro s t h
  exact Subtype.ext (Multiset.toFinsupp.injective h)

theorem eval_monomial_multiset {α : Type*} [DecidableEq α]
    (m : Multiset α) (z : α → ℂ) :
    MvPolynomial.eval z (MvPolynomial.monomial m.toFinsupp (1 : ℂ)) = (m.map z).prod := by
  induction m using Multiset.induction_on with
  | empty => simp
  | @cons a m ih =>
    rw [← Multiset.singleton_add, Multiset.toFinsupp_add, Multiset.toFinsupp_singleton,
      ← one_mul (1 : ℂ), ← MvPolynomial.monomial_mul_monomial, map_mul]
    have hx : MvPolynomial.eval z
        (MvPolynomial.monomial (Finsupp.single a 1) (1 : ℂ)) = z a := by
      change MvPolynomial.eval z (MvPolynomial.X a) = z a
      exact MvPolynomial.eval_X _
    rw [hx, ih]
    simp

def monomialCoordinates (D k : ℕ) (z : Fin D → ℂ) : Sym (Fin D) k → ℂ :=
  fun s => MvPolynomial.eval z (MvPolynomial.monomial (occupationExponent s) 1)

/-- Independence of distinct occupation monomials forces their evaluation vectors to span.
This is a theorem about actual complex evaluations, not a spanning hypothesis. -/
theorem monomialCoordinates_span_top (D k : ℕ) :
    Submodule.span ℂ (Set.range (monomialCoordinates D k)) = ⊤ := by
  classical
  let S := Submodule.span ℂ (Set.range (monomialCoordinates D k))
  apply Submodule.dualAnnihilator_eq_bot_iff.mp
  apply le_antisymm ?_ bot_le
  intro φ hφ
  change φ = 0
  have hzero : ∀ z, φ (monomialCoordinates D k z) = 0 := by
    intro z
    exact (Submodule.mem_dualAnnihilator φ).mp hφ _ (Submodule.subset_span ⟨z, rfl⟩)
  let Q : MvPolynomial (Fin D) ℂ :=
    ∑ s : Sym (Fin D) k,
      MvPolynomial.monomial (occupationExponent s) (φ (Pi.single s 1))
  have hQ : Q = 0 := by
    apply MvPolynomial.funext
    intro z
    rw [map_zero]
    have hexp : monomialCoordinates D k z =
        ∑ s : Sym (Fin D) k, monomialCoordinates D k z s • Pi.single s 1 := by
      ext t
      simp [Pi.single_apply]
    have hz := hzero z
    rw [hexp, map_sum] at hz
    simpa [Q, MvPolynomial.eval_monomial, monomialCoordinates,
      map_smul, smul_eq_mul, mul_comm] using hz
  have hbasis : ∀ s : Sym (Fin D) k, φ (Pi.single s 1) = 0 := by
    intro s
    have hc := congrArg (fun p : MvPolynomial (Fin D) ℂ => p.coeff (occupationExponent s)) hQ
    have heq : ∀ t : Sym (Fin D) k,
        occupationExponent t = occupationExponent s ↔ t = s := by
      intro t
      exact ⟨fun h => (occupationExponent_injective D k) h,
        fun h => by rw [h]⟩
    simpa [Q, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, heq] using hc
  apply LinearMap.ext
  intro x
  have hx : x = ∑ s : Sym (Fin D) k, x s • Pi.single s 1 := by
    ext t
    simp [Pi.single_apply]
  rw [hx, map_sum]
  simp [map_smul, hbasis]

theorem purePower_occupationCoordinates (D k : ℕ) (z : Fin D → ℂ) :
    (occupationColumns (occupation D k)).mulVec (monomialCoordinates D k z) =
      purePower D k z := by
  classical
  ext w
  simp only [Matrix.mulVec, dotProduct, occupationColumns, ite_mul, one_mul, zero_mul]
  simp only [Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  rw [monomialCoordinates, occupationExponent, eval_monomial_multiset]
  change (((List.Vector.ofFn w).toList : List (Fin D)).map z).prod = _
  simp [purePower, List.Vector.toList_ofFn, List.prod_ofFn]

/-- Every occupation column is a finite complex linear combination of actual pure iid powers. -/
theorem occupationColumns_mem_purePower_span (D k : ℕ) (s : Sym (Fin D) k) :
    (fun w => occupationColumns (occupation D k) w s) ∈
      Submodule.span ℂ (Set.range (purePower D k)) := by
  classical
  have hmem : Pi.single s (1 : ℂ) ∈
      Submodule.span ℂ (Set.range (monomialCoordinates D k)) := by
    rw [monomialCoordinates_span_top]
    exact Submodule.mem_top
  let E := (occupationColumns (occupation D k)).mulVecLin
  have hm := Submodule.mem_map_of_mem (f := E) hmem
  rw [Submodule.map_span] at hm
  have hr : E '' Set.range (monomialCoordinates D k) = Set.range (purePower D k) := by
    ext v
    constructor
    · rintro ⟨_, ⟨z, rfl⟩, rfl⟩
      exact ⟨z, (purePower_occupationCoordinates D k z).symm⟩
    · rintro ⟨z, rfl⟩
      exact ⟨_, ⟨z, rfl⟩, purePower_occupationCoordinates D k z⟩
  rw [hr] at hm
  change (occupationColumns (occupation D k)).mulVec (Pi.single s 1) ∈ _ at hm
  convert hm using 1
  ext w
  simp [Matrix.mulVec, dotProduct, Pi.single_apply]

/-- The fixed projector has exactly the common support generated by all pure iid inputs. -/
theorem symmetricProjector_range_eq_purePower_span (D k : ℕ) :
    LinearMap.range (symmetricProjector D k).mulVecLin =
      Submodule.span ℂ (Set.range (purePower D k)) := by
  classical
  apply le_antisymm
  · rintro v ⟨x, rfl⟩
    change (occupationColumns (occupation D k) *
      occupationAverage (occupation D k)).mulVec x ∈ _
    rw [← Matrix.mulVec_mulVec]
    have hvec : ∀ (c : Sym (Fin D) k → ℂ),
        (occupationColumns (occupation D k)).mulVec c =
          ∑ s : Sym (Fin D) k, c s • (fun w => occupationColumns (occupation D k) w s) := by
      intro c
      ext w
      simp [Matrix.mulVec, dotProduct, mul_comm]
    rw [hvec]
    exact Submodule.sum_mem _ (fun s _ => Submodule.smul_mem _ _
      (occupationColumns_mem_purePower_span D k s))
  · apply Submodule.span_le.mpr
    rintro v ⟨z, rfl⟩
    exact ⟨purePower D k z, symmetricProjector_fixes_purePower D k z⟩

end
end SymmetricSupport
