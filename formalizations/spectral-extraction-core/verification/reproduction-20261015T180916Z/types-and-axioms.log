Extraction.finite_projection_fidelity_extractor (a b d K : ℕ) (hd : 0 < d) (hdk : d ≤ K)
  (P : Matrix (Fin a × Fin b) (Fin a × Fin b) ℂ) (hP : P.IsHermitian) (hPP : P * P = P)
  (hr : P.rank ≤ a / d * (b / d)) :
  ∃ U A B,
    ∑ j, (A j).conjTranspose * A j = 1 ∧
      ∑ j, (B j).conjTranspose * B j = 1 ∧
        ∀ (X : Matrix (Fin a × Fin b) (Fin a × Fin b) ℂ),
          APPT.Quantum.IsDensity X →
            P * X * P = X →
              (Extraction.bellProjector *
                      Extraction.krausApply (Extraction.productKraus A B) (↑U * X * (↑U).conjTranspose)).trace.re =
                ↑d / ↑K
