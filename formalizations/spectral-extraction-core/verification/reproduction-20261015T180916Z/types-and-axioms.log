Extraction.kraus_target_overlap_unitary_le.{u_1, u_2, u_3, u_4} {a : Type u_1} {b : Type u_2} {d : Type u_3}
  {κ : Type u_4} [Fintype a] [Fintype b] [Fintype d] [Fintype κ] [DecidableEq a] [DecidableEq b] [DecidableEq d]
  [Nonempty d] (A : κ → Matrix (d × d) (a × b) ℂ) (hcomplete : ∑ j, (A j).conjTranspose * A j = 1)
  (hpt : Extraction.PTConjugatePositive A) (X : Matrix (a × b) (a × b) ℂ) (hX : X.IsHermitian)
  (U : ↥(Matrix.unitaryGroup (a × b) ℂ)) :
  (Extraction.bellProjector * Extraction.krausApply A (↑U * X * (↑U).conjTranspose)).trace.re ≤
    √((X * X).trace.re * (↑(Fintype.card a) * ↑(Fintype.card b) / ↑(Fintype.card d) ^ 2))
