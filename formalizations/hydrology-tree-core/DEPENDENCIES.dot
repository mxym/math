digraph HydrologyTreePartial {
  rankdir=LR;
  label="Partial formalization: all-tree main theorem absent";
  "HydrologyTree.Coefficients" -> "HydrologyTree.LeadingCoefficients";
  "HydrologyTree.Coefficients" -> "HydrologyTree.BlockJacobian";
  "HydrologyTree.LeadingCoefficients" -> "HydrologyTree.Scaling";
  "HydrologyTree.BlockJacobian" -> "HydrologyTree.Scaling";
  "HydrologyTree.BlockJacobian" -> "HydrologyTree.Triangular";
  "HydrologyTree.BlockJacobian" -> "HydrologyTree.Gluing";
  "HydrologyTree.Scaling" -> "HydrologyTree.RootUpdate";
  "HydrologyTree.Triangular" -> "HydrologyTree.RootUpdate";
  "HydrologyTree.Gluing" -> "HydrologyTree";
  "HydrologyTree.RootUpdate" -> "HydrologyTree";
}
