import Entry002.Graphs

/-!
# Restoring exceptional graph vertices

The graph counting argument of v3, Section 9. The enlarged exceptional graph
must contain every edge witnessed by a full-graph walk of at most `B + 1` edges.
For a metric graph this follows from its enlarged radius `D * (B + 1)`.
-/

namespace Entry002

universe u v

/-- A finite union of finite sets of uniformly bounded cardinality. -/
theorem finite_biUnion_bound {I : Type v} {V : Type u} (s : Set I)
    (hs : s.Finite) (f : I → Set V) (K : ℕ)
    (hbound : ∀ i ∈ s, (f i).Finite ∧ (f i).ncard ≤ K) :
    (⋃ i ∈ s, f i).Finite ∧ (⋃ i ∈ s, f i).ncard ≤ s.ncard * K := by
  classical
  induction s, hs using Set.Finite.induction_on with
  | empty => simp
  | @insert a s ha hs ih =>
      have ha' := hbound a (Set.mem_insert a s)
      have hs' := ih (fun i hi => hbound i (Set.mem_insert_of_mem a hi))
      rw [Set.biUnion_insert]
      refine ⟨ha'.1.union hs'.1, ?_⟩
      calc
        (f a ∪ ⋃ i ∈ s, f i).ncard ≤ (f a).ncard + (⋃ i ∈ s, f i).ncard :=
          Set.ncard_union_le _ _
        _ ≤ K + s.ncard * K := Nat.add_le_add ha'.2 hs'.2
        _ = (insert a s).ncard * K := by
          rw [Set.ncard_insert_of_notMem ha hs, Nat.add_mul]
          simp [Nat.add_comm]

variable {V : Type u} (G : SimpleGraph V) (E : Set V)

/-- The ordinary component at `z`, or the empty set if `z` is exceptional. -/
noncomputable def ordinaryBlock (z : V) : Set V := by
  classical
  exact if hz : z ∈ Eᶜ then
    Subtype.val '' componentVertices (G.induce Eᶜ) ⟨z, hz⟩
  else ∅

theorem mem_ordinaryBlock {z y : V} : y ∈ ordinaryBlock G E z ↔
    ∃ hz : z ∈ Eᶜ, ∃ hy : y ∈ Eᶜ,
      (G.induce Eᶜ).Reachable ⟨z, hz⟩ ⟨y, hy⟩ := by
  classical
  by_cases hz : z ∈ Eᶜ
  · simp only [ordinaryBlock, dite_eq_left hz]
    constructor
    · rintro ⟨⟨y, hy⟩, hreach, rfl⟩
      exact ⟨hz, hy, hreach⟩
    · rintro ⟨hz', hy, hreach⟩
      exact ⟨⟨y, hy⟩, hreach, rfl⟩
  · simp [ordinaryBlock, hz]

theorem ordinaryBlock_bound {B : ℕ}
    (hB : UniformComponentBound (G.induce Eᶜ) B) (z : V) :
    (ordinaryBlock G E z).Finite ∧ (ordinaryBlock G E z).ncard ≤ B := by
  classical
  by_cases hz : z ∈ Eᶜ
  · simp only [ordinaryBlock, dite_eq_left hz]
    exact ⟨(hB ⟨z, hz⟩).1.image Subtype.val,
      (Set.ncard_image_le (hB ⟨z, hz⟩).1).trans (hB ⟨z, hz⟩).2⟩
  · simp [ordinaryBlock, hz]

/-- An exceptional vertex and every ordinary component attached to a neighbor. -/
noncomputable def restoredStar (c : E) : Set V :=
  {c.val} ∪ ⋃ z ∈ G.neighborSet c.val, ordinaryBlock G E z

theorem restoredStar_bound {B Δ : ℕ}
    (hB : UniformComponentBound (G.induce Eᶜ) B)
    (hdegree : ∀ x, (G.neighborSet x).Finite ∧ (G.neighborSet x).ncard ≤ Δ)
    (c : E) : (restoredStar G E c).Finite ∧
      (restoredStar G E c).ncard ≤ 1 + Δ * B := by
  have hn := finite_biUnion_bound (G.neighborSet c.val) (hdegree c.val).1
    (ordinaryBlock G E) B (fun z _ => ordinaryBlock_bound G E hB z)
  refine ⟨(Set.finite_singleton _).union hn.1, ?_⟩
  calc
    (restoredStar G E c).ncard ≤ 1 + (⋃ z ∈ G.neighborSet c.val,
        ordinaryBlock G E z).ncard := by
      simpa only [restoredStar, Set.ncard_singleton] using
        (Set.ncard_union_le {c.val} (⋃ z ∈ G.neighborSet c.val, ordinaryBlock G E z))
    _ ≤ 1 + Δ * B := Nat.add_le_add_left
      (hn.2.trans (Nat.mul_le_mul_right B (hdegree c.val).2)) 1

variable (H : SimpleGraph E)

/-- The finite cover generated by an exceptional component. -/
noncomputable def restoredCover (e : E) : Set V :=
  ⋃ c ∈ componentVertices H e, restoredStar G E c

theorem restoredCover_bound {B Δ M : ℕ}
    (hB : UniformComponentBound (G.induce Eᶜ) B)
    (hdegree : ∀ x, (G.neighborSet x).Finite ∧ (G.neighborSet x).ncard ≤ Δ)
    (hM : UniformComponentBound H M) (e : E) :
    (restoredCover G E H e).Finite ∧
      (restoredCover G E H e).ncard ≤ M * (1 + Δ * B) := by
  have hc := finite_biUnion_bound (componentVertices H e) (hM e).1
    (restoredStar G E) (1 + Δ * B) (fun c _ => restoredStar_bound G E hB hdegree c)
  exact ⟨hc.1, hc.2.trans (Nat.mul_le_mul_right _ (hM e).2)⟩

/-- The enlarged exceptional graph contains the endpoints of every short
full-graph walk. In the metric application its radius is `D * (B + 1)`. -/
def ShortWalkBridge (B : ℕ) : Prop :=
  ∀ c d : E, c ≠ d → ∀ p : G.Walk c.val d.val,
    p.length ≤ B + 1 → H.Adj c d

/-- A passage through one ordinary component is short enough to be bridged
by the enlarged exceptional graph. -/
theorem ordinary_excursion_reachable {B : ℕ}
    (hB : UniformComponentBound (G.induce Eᶜ) B)
    (hbridge : ShortWalkBridge G E H B) (c d : E) (z y : ↥(Eᶜ))
    (hcz : G.Adj c.val z.val) (hzy : (G.induce Eᶜ).Reachable z y)
    (hyd : G.Adj y.val d.val) : H.Reachable c d := by
  by_cases hcd : c = d
  · subst d
    exact SimpleGraph.Reachable.rfl
  · apply hzy.elim_path
    intro q
    let φ : G.induce Eᶜ →g G :=
      { toFun := Subtype.val, map_rel' := fun h => h }
    let p : G.Walk c.val d.val :=
      ((q.val.map φ).cons hcz).concat hyd
    have hlength := path_terms_le (G.induce Eᶜ) hB q.val q.property
    have hp : p.length ≤ B + 1 := by
      change (((q.val.map φ).cons hcz).concat hyd).length ≤ B + 1
      rw [SimpleGraph.Walk.length_concat]
      change (q.val.map φ).length + 1 + 1 ≤ B + 1
      rw [SimpleGraph.Walk.length_map]
      omega
    exact (hbridge c d hcd p hp).reachable

theorem exception_mem_restoredCover {e c : E} (hc : H.Reachable e c) :
    c.val ∈ restoredCover G E H e := by
  simp only [restoredCover, restoredStar, Set.mem_iUnion, Set.mem_union,
    Set.mem_singleton_iff]
  exact ⟨c, hc, Or.inl rfl⟩

theorem ordinary_mem_restoredCover {e c : E} (hc : H.Reachable e c)
    {z y : V} (hcz : G.Adj c.val z) (hy : y ∈ ordinaryBlock G E z) :
    y ∈ restoredCover G E H e := by
  simp only [restoredCover, restoredStar, Set.mem_iUnion, Set.mem_union,
    Set.mem_singleton_iff]
  exact ⟨c, hc, Or.inr ⟨z, hcz, hy⟩⟩

/-- The cover of an exceptional component is closed under full-graph edges.
This is the actual reachability link needed for restoration. -/
theorem restoredCover_adj_closed {B : ℕ}
    (hB : UniformComponentBound (G.induce Eᶜ) B)
    (hbridge : ShortWalkBridge G E H B) (e : E) {x y : V}
    (hx : x ∈ restoredCover G E H e) (hxy : G.Adj x y) :
    y ∈ restoredCover G E H e := by
  classical
  simp only [restoredCover, restoredStar, Set.mem_iUnion, Set.mem_union,
    Set.mem_singleton_iff] at hx
  obtain ⟨c, hc, hstar⟩ := hx
  rcases hstar with hxc | ⟨z, hcz, hxz⟩
  · subst x
    by_cases hy : y ∈ E
    · let d : E := ⟨y, hy⟩
      have hcd : c ≠ d := by
        intro heq
        exact hxy.ne (congrArg Subtype.val heq)
      have hlen : hxy.toWalk.length ≤ B + 1 := by simp
      exact exception_mem_restoredCover G E H
        (hc.trans (hbridge c d hcd hxy.toWalk hlen).reachable)
    · exact ordinary_mem_restoredCover G E H hc hxy
        ((mem_ordinaryBlock G E).mpr ⟨hy, hy, SimpleGraph.Reachable.rfl⟩)
  · obtain ⟨hz, hx, hzx⟩ := (mem_ordinaryBlock G E).mp hxz
    by_cases hy : y ∈ E
    · let d : E := ⟨y, hy⟩
      have hcd := ordinary_excursion_reachable G E H hB hbridge c d
        ⟨z, hz⟩ ⟨x, hx⟩ hcz hzx hxy
      exact exception_mem_restoredCover G E H (hc.trans hcd)
    · have hzy : (G.induce Eᶜ).Reachable ⟨z, hz⟩ ⟨y, hy⟩ :=
        hzx.trans (SimpleGraph.Adj.reachable (G := G.induce Eᶜ) hxy)
      exact ordinary_mem_restoredCover G E H hc hcz
        ((mem_ordinaryBlock G E).mpr ⟨hz, hy, hzy⟩)

/-- An adjacency-closed set contains every vertex reachable from its members. -/
theorem reachable_mem_of_adj_closed (S : Set V)
    (hclosed : ∀ {x y}, x ∈ S → G.Adj x y → y ∈ S)
    {x y : V} (hx : x ∈ S) (hxy : G.Reachable x y) : y ∈ S := by
  obtain ⟨p⟩ := hxy
  induction p with
  | nil => exact hx
  | cons h p ih => exact ih (hclosed hx h)

theorem component_subset_restoredCover {B : ℕ}
    (hB : UniformComponentBound (G.induce Eᶜ) B)
    (hbridge : ShortWalkBridge G E H B) (e : E) :
    componentVertices G e.val ⊆ restoredCover G E H e := by
  intro y hy
  exact reachable_mem_of_adj_closed G (restoredCover G E H e)
    (fun hx hxy => restoredCover_adj_closed G E H hB hbridge e hx hxy)
    (exception_mem_restoredCover G E H SimpleGraph.Reachable.rfl) hy

/-- A full component that never meets the exceptional set lies in one actual
component of the graph induced on the ordinary vertices. -/
theorem component_subset_ordinaryBlock {x : V}
    (hno : ∀ y, G.Reachable x y → y ∉ E) :
    componentVertices G x ⊆ ordinaryBlock G E x := by
  classical
  intro y hxy
  obtain ⟨p⟩ := hxy
  have hs : ∀ z ∈ p.support, z ∈ Eᶜ := by
    intro z hz
    exact hno z (p.takeUntil z hz).reachable
  exact (mem_ordinaryBlock G E).mpr
    ⟨hno x SimpleGraph.Reachable.rfl, hno y p.reachable, ⟨p.induce Eᶜ hs⟩⟩

/-- The full graph restoration bound of v3, Section 9.

The hypotheses concern only the actual induced ordinary graph, degrees, the
enlarged exceptional graph, and its short-walk edge rule. No full-component
bound is assumed. The infinite exceptional set itself need not be finite. -/
theorem uniformComponentBound_restoration {B Δ M : ℕ}
    (hB : UniformComponentBound (G.induce Eᶜ) B)
    (hdegree : ∀ x, (G.neighborSet x).Finite ∧ (G.neighborSet x).ncard ≤ Δ)
    (hM : UniformComponentBound H M)
    (hbridge : ShortWalkBridge G E H B) :
    UniformComponentBound G (max B (M * (1 + Δ * B))) := by
  classical
  intro x
  by_cases hex : ∃ e : E, G.Reachable x e.val
  · obtain ⟨e, he⟩ := hex
    have hcover := restoredCover_bound G E H hB hdegree hM e
    have hsub : componentVertices G x ⊆ restoredCover G E H e := by
      intro y hy
      exact component_subset_restoredCover G E H hB hbridge e (he.symm.trans hy)
    exact ⟨hcover.1.subset hsub,
      ((Set.ncard_le_ncard hsub hcover.1).trans hcover.2).trans (Nat.le_max_right _ _)⟩
  · have hno : ∀ y, G.Reachable x y → y ∉ E := by
      intro y hy hye
      exact hex ⟨⟨y, hye⟩, hy⟩
    have hblock := ordinaryBlock_bound G E hB x
    have hsub := component_subset_ordinaryBlock G E hno
    exact ⟨hblock.1.subset hsub,
      ((Set.ncard_le_ncard hsub hblock.1).trans hblock.2).trans (Nat.le_max_left _ _)⟩

end Entry002
