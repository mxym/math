+theorem truncation_sharpness_from_actual_defect_formula
+    (hformula : ∀ d : ℕ, 3 ≤ d → ∀ t : ℝ, 0 < t → t < 1 →
+      entryDefect (truncationSet d t) = truncationRationalDefect d t) :
+    truncationSharpnessGoal := by
