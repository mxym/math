+  ((d + 1).factorial : ℝ) * (1 / ((d - 1).factorial : ℝ)) ^ (d + 1) *
+    ((1 - t ^ (d - 1)) ^ d * (1 + t ^ d) +
+      (d : ℝ) * (1 - t ^ (d - 1)) ^ (d - 1) * (t ^ (d - 1) - t ^ d))
