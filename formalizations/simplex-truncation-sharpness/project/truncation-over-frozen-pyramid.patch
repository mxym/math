+      Fin.cons z (Fin.cons v g) := by
+    funext i
+    induction i using Fin.cases with
+    | zero => simp
+    | succ i =>
+      induction i using Fin.cases with
+      | zero => simp
+      | succ i =>
+        rw [Function.comp_apply, Equiv.swap_apply_of_ne_of_ne
