+  obtain ⟨t, ht, htε, hp, hs, hb⟩ :=
+    truncation_conditional_scalar_power_obstruction hd
+      (fun t => entryDefect (truncationSet d t)) (hformula d hd) hα C hε
+  have ht1 : t < 1 := htε.trans_le (min_le_right ε 1)
+  have hdpos : 0 < d := by omega
