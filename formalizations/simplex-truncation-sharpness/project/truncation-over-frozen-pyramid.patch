+        0 < truncationRationalDefect d t ∧ truncationRationalDefect d t < ε ∧
+        C * (truncationRationalDefect d t) ^ α < (d + 1) * t := by
+    filter_upwards [self_mem_nhdsWithin, hsmall, he, hr] with t ht htε het hrt
