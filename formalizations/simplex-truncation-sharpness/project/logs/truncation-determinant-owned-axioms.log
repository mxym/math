Entry005.truncation_packed_horizontal_tuple_sum {d : ℕ} (hd : 2 ≤ d) (c r q : ℝ) (hc : 0 ≤ c) (hr : 0 ≤ r)
  (hq : 0 ≤ q) :
  Entry005.truncationPackedTupleSum (Entry005.truncationPackedHorizontal d c r q) =
    ↑d.factorial * c ^ d * (r ^ d + ↑d * (1 + q) * r ^ (d - 1))
Entry005.truncation_packed_lifted_tuple_sum {d : ℕ} (hd : 1 ≤ d) (c r q s : ℝ) (hc : 0 ≤ c) (hr : 0 ≤ r) (hs : 0 ≤ s)
  (hqs : s ≤ q) :
  Entry005.truncationPackedTupleSum (Entry005.truncationPackedLifted d c r q s) =
    ↑(d + 1).factorial * c ^ (d + 1) * (r ^ d * (1 + s) + ↑d * r ^ (d - 1) * (q - s))
Entry005.truncation_scalar_cancellation {d : ℕ} (hd : 2 ≤ d) {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
  Entry005.truncationScalarLiftedSum d t /
        ((↑d + 1) * ↑d * ((1 - t ^ d) / ↑d.factorial) * Entry005.truncationScalarHorizontalSum d t) -
      1 / (↑d + 1) =
    Entry005.truncationRationalDefect d t
