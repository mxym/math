def Entry005.truncationSharpnessGoal : Prop :=
∀ (d : ℕ),
  3 ≤ d →
    ∀ (α : ℝ),
      1 / ↑(d - 1) < α →
        ∀ (C ε : ℝ),
          0 ≤ C →
            0 < ε →
              ∃ t,
                0 < t ∧
                  t < min ε 1 ∧
                    ∃ K,
                      ↑K = Entry005.truncationSet d t ∧
                        (interior ↑K).Nonempty ∧
                          ∃ S,
                            Entry005.maximumInscribed K S ∧
                              0 < Entry005.entryDefect ↑K ∧
                                Entry005.entryDefect ↑K < ε ∧ C * Entry005.entryDefect ↑K ^ α < Entry005.excess (↑K) S
def Entry005.entryDefect.{u_1} : {E : Type u_1} →
  [inst : NormedAddCommGroup E] →
    [inst_1 : InnerProductSpace ℝ E] →
      [FiniteDimensional ℝ E] → [inst_3 : MeasurableSpace E] → [BorelSpace E] → Set E → ℝ :=
fun {E} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] K =>
  Entry005.entryA K - 1 / (↑(Module.finrank ℝ E) + 1)
def Entry005.maximumInscribed : {d : ℕ} →
  ConvexBody (Entry005.Space d) → Affine.Simplex ℝ (Entry005.Space d) d → Prop :=
fun {d} K S =>
  Entry005.simplexSet S ⊆ ↑K ∧
    ∀ (T : Affine.Simplex ℝ (Entry005.Space d) d),
      Entry005.simplexSet T ⊆ ↑K →
        MeasureTheory.volume (Entry005.simplexSet T) ≤ MeasureTheory.volume (Entry005.simplexSet S)
def Entry005.centeredDilation : {d : ℕ} → Affine.Simplex ℝ (Entry005.Space d) d → ℝ → Set (Entry005.Space d) :=
fun {d} S t => (fun x => S.centroid + (1 + t) • (x - S.centroid)) '' Entry005.simplexSet S
def Entry005.excess : {d : ℕ} → Set (Entry005.Space d) → Affine.Simplex ℝ (Entry005.Space d) d → ℝ :=
fun {d} K S => sInf {t | 0 ≤ t ∧ K ⊆ Entry005.centeredDilation S t}
