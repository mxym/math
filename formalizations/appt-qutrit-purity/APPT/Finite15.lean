theorem certificate_identity (g : Fin 15 → ℝ) : (23*(total g)^2-289*squareTotal g)*total g = rhs g := by
  simp [rhs, total, squareTotal, outer, spectrum, detA, detB, minorA, minorB, quadA, quadB, ratio, matA, matB, Matrix.det_fin_three, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
  <;> ring

theorem certificate_nonneg (g : Fin 15 → ℝ) (hg : ∀ i, 0 ≤ g i) (hA : (matA (outer g)).PosSemidef)
    (hB : (matB (outer g)).PosSemidef) :
    0 ≤ (23*(total g)^2-289*squareTotal g)*total g := by
  rw [certificate_identity]
  have hg0 : 0 ≤ g 0 := hg 0
  have hg1 : 0 ≤ g 1 := hg 1
  have hg2 : 0 ≤ g 2 := hg 2
  have hg3 : 0 ≤ g 3 := hg 3
  have hg4 : 0 ≤ g 4 := hg 4
  have hg5 : 0 ≤ g 5 := hg 5
  have hg6 : 0 ≤ g 6 := hg 6
  have hg7 : 0 ≤ g 7 := hg 7
  have hg8 : 0 ≤ g 8 := hg 8
  have hg9 : 0 ≤ g 9 := hg 9
  have hg10 : 0 ≤ g 10 := hg 10
  have hg11 : 0 ≤ g 11 := hg 11
  have hg12 : 0 ≤ g 12 := hg 12
  have hg13 : 0 ≤ g 13 := hg 13
  have hg14 : 0 ≤ g 14 := hg 14
  have hdA := detA_nonneg (outer g) hA
  have hmA01 := minorA_nonneg (outer g) hA 0 1
  have hmA02 := minorA_nonneg (outer g) hA 0 2
  have hmA12 := minorA_nonneg (outer g) hA 1 2
  have hdB := detB_nonneg (outer g) hB
  have hmB01 := minorB_nonneg (outer g) hB 0 1
  have hmB02 := minorB_nonneg (outer g) hB 0 2
  have hmB12 := minorB_nonneg (outer g) hB 1 2
  have hqA122 := quadA_nonneg (outer g) hA ![1,2,2]
  have hqA212 := quadA_nonneg (outer g) hA ![2,1,2]
  have hqA221 := quadA_nonneg (outer g) hA ![2,2,1]
  have hqB110 := quadB_nonneg (outer g) hB ![1,1,0]
  have hqB122 := quadB_nonneg (outer g) hB ![1,2,2]
  have hqB221 := quadB_nonneg (outer g) hB ![2,2,1]
  dsimp only [rhs]
  positivity

theorem normalized_bound (g : Fin 15 → ℝ) (hg : ∀ i, 0 ≤ g i) (hA : (matA (outer g)).PosSemidef)
    (hB : (matB (outer g)).PosSemidef) (hT : total g = 1) :
    squareTotal g ≤ (23 : ℝ)/289 := by
  have h := certificate_nonneg g hg hA hB
  rw [hT] at h
  nlinarith

