  simp only [CoefficientMerge.eval_fastMerge, CoefficientMerge.eval_scale, eval_det00Term0Coeffs, eval_det00Term1Coeffs, eval_det00Term2Coeffs, eval_det00Term3Coeffs, eval_det00Term4Coeffs, eval_det00Term5Coeffs, eval_det00Pair0, eval_det00Pair1, eval_det00Pair2, eval_det00Pair3, eval_det00Pair4, eval_det00Pair5, eval_entryA00, eval_entryA01, eval_entryA02, eval_entryA10, eval_entryA11, eval_entryA12, eval_entryA20, eval_entryA21, eval_entryA22]
  simp only [detA, Matrix.det_fin_three]
  push_cast
  ring
theorem base00_nonneg (g : Fin 9 → ℝ) (hg : ∀ i, 0 ≤ g i) (hA : (matA (outer g)).PosSemidef) (hB : (matB (outer g)).PosSemidef) : 0 ≤ SparsePolynomial.eval (gapValues g) base00 := by
  rw [eval_base00]
  exact detA_nonneg (outer g) hA

end APPT.Finite9
