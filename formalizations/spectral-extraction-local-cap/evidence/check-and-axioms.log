ExtractionLocalCap.kraus_target_overlap_full_envelope.{u_1, u_2, u_3, u_4} {a : Type u_1} {b : Type u_2} [Fintype a]
  [Fintype b] [LinearOrder a] [DecidableEq b] {d : Type u_3} {κ : Type u_4} [Fintype d] [Fintype κ] [DecidableEq d]
  [Nonempty d] (A : κ → Matrix (d × d) (a × b) ℂ) (hcomplete : ∑ j, (A j).conjTranspose * A j = 1)
  (hpt : Extraction.PTConjugatePositive A) (X : Matrix (a × b) (a × b) ℂ) (hX : APPT.Quantum.IsDensity X)
  (U : ↥(Matrix.unitaryGroup (a × b) ℂ)) :
  (Extraction.bellProjector * Extraction.krausApply A (↑U * X * (↑U).conjTranspose)).trace.re ≤
    min 1
      (min (↑(Fintype.card a) / ↑(Fintype.card d))
        √((X * X).trace.re * (↑(Fintype.card a) * ↑(Fintype.card b) / ↑(Fintype.card d) ^ 2)))
