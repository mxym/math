ConcreteNativeExtraction.concrete_assembled_compiler_exists :
  ∃ net,
    (∀ (k p : ℕ) (z : Fin 4 → ℂ),
        SymmetricSupport.IsUnitVector z →
          1 - (1 / 2) ^ p ≤
            (Extraction.bellProjector *
                  CircuitRecursion.approximateExtractionOutput k
                    (CircuitCompletion.denote
                      (EffectiveEncoding.labelCircuit RationalGateInterface.rationalGate
                        (ConcreteNativeExtraction.assembledRun net k p).compilation.word))
                    (CircuitCompletion.pureMatrix (CircuitRecursion.bitPurePower k z))).trace.re) ∧
      (∀ (k p : ℕ),
          (ConcreteNativeExtraction.assembledRun net k p).accountedPrimitiveActions ≤
            ConcreteNativeExtraction.assembledPrimitiveBound net k p) ∧
        (∀ (k p : ℕ),
            (ConcreteNativeExtraction.assembledRun net k p).compilation.word.length ≤
              EffectiveEncoding.actualGatePolynomial k *
                (32 * (net.lengthBound + 1) * (EffectiveEncoding.logarithmicPrecision k p + 1) ^ 5)) ∧
          ∀ (k p : ℕ),
            ∀
              g ∈
                EffectiveEncoding.labelCircuit RationalGateInterface.rationalGate
                  (ConcreteNativeExtraction.assembledRun net k p).compilation.word,
              CircuitRecursion.usesFiniteLibrary RationalGateInterface.rationalGate g
