ConcreteNativeExtraction.assembledRun_word (net : ConcreteNativeExtraction.OfflineNet) (k p : ℕ) :
  (ConcreteNativeExtraction.assembledRun net k p).compilation.word =
    EffectiveEncoding.numericalExtractionCode
      (fun i => CircuitRecursion.nativePacketDataOracle (RationalGateBinary.nativeEntry i))
      RationalGateInterface.inverseLabel net.table net.lengthBound k p
