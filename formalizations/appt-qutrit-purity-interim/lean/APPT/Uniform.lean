  have hqA100 := quadA_nonneg (outer g) hA ![1,0,0]
  have hqA102 := quadA_nonneg (outer g) hA ![1,0,2]
  have hqA111 := quadA_nonneg (outer g) hA ![1,1,1]
  have hqA120 := quadA_nonneg (outer g) hA ![1,2,0]
  have hqA122 := quadA_nonneg (outer g) hA ![1,2,2]
  have hqA201 := quadA_nonneg (outer g) hA ![2,0,1]
  have hqA210 := quadA_nonneg (outer g) hA ![2,1,0]
  have hqA211 := quadA_nonneg (outer g) hA ![2,1,1]
  have hqA212 := quadA_nonneg (outer g) hA ![2,1,2]
  have hqA221 := quadA_nonneg (outer g) hA ![2,2,1]
  have hqB010 := quadB_nonneg (outer g) hB ![0,1,0]
  have hqB012 := quadB_nonneg (outer g) hB ![0,1,2]
  have hqB021 := quadB_nonneg (outer g) hB ![0,2,1]
  have hqB102 := quadB_nonneg (outer g) hB ![1,0,2]
  have hqB110 := quadB_nonneg (outer g) hB ![1,1,0]
  have hqB120 := quadB_nonneg (outer g) hB ![1,2,0]
  have hqB122 := quadB_nonneg (outer g) hB ![1,2,2]
  have hqB201 := quadB_nonneg (outer g) hB ![2,0,1]
  have hqB210 := quadB_nonneg (outer g) hB ![2,1,0]
  have hqB211 := quadB_nonneg (outer g) hB ![2,1,1]
  have hqB212 := quadB_nonneg (outer g) hB ![2,1,2]
  have hqB221 := quadB_nonneg (outer g) hB ![2,2,1]
  have hr : 0 ≤ ratio (outer g) := by
    simp [ratio, quadA, matA, Matrix.mulVec, dotProduct,
      outer, spectrum, Fin.sum_univ_succ] at hqA111 ⊢
    linarith
  dsimp only [rhs]
  positivity

theorem normalized_bound (g : Fin 9 → ℝ) (t z : ℝ) (hg : ∀ i, 0 ≤ g i) (hA : (matA (outer g)).PosSemidef)
    (hB : (matB (outer g)).PosSemidef) (ht : 0 ≤ t) (hz : 0 ≤ z)
    (hw : 0 ≤ t+z-18) (hT : total g t z = 1) :
    squareTotal g t z ≤ 9 / (8*(9+t+z)) := by
  have h := certificate_nonneg g t z hg hA hB ht hz hw
  rw [hT] at h
  have hp : 0 < (8 : ℝ)*(9+t+z) := by positivity
  apply (le_div_iff₀ hp).2
  nlinarith

end APPT.Uniform
