ExtractionSchur.haarTwirl_eq_finiteHaarProjection (D k : ℕ)
  (A : Matrix (SymmetricSupport.Word D k) (SymmetricSupport.Word D k) ℂ) :
  ExtractionSchur.haarTwirl D k A = ExtractionSchur.finiteHaarProjection D k A
ExtractionSchur.flatHaarAverage_two_finite_quantities (D s k : ℕ) (hs : 0 < s) (hsD : s ≤ D) :
  (ExtractionSchur.flatHaarAverage D s k hsD).rank = (ExtractionRankSupport.supportCoefficientMatrix D k s).rank ∧
    (ExtractionSchur.flatHaarAverage D s k hsD * ExtractionSchur.flatHaarAverage D s k hsD).trace =
      star
          (ExtractionSchur.matrixVectorEquiv
            (ExtractionSpectrum.tensorMatrix (ExtractionRankSupport.flatCoordinateDensity D s hsD) k)) ⬝ᵥ
        (ExtractionSchur.permutationHSProjector D k).mulVec
          (ExtractionSchur.matrixVectorEquiv
            (ExtractionSpectrum.tensorMatrix (ExtractionRankSupport.flatCoordinateDensity D s hsD) k))
ExtractionSchur.prefixAntisymmetrizer_mul_rankBudgetProjector (D l t s : ℕ) (hsl : s < l) :
  ExtractionSchur.prefixAntisymmetrizer D l t * ExtractionRankSupport.rankBudgetProjector D (l + t) s = 0
ExtractionSchur.rankBudgetProjector_mem_permutationSpan (D k s : ℕ) :
  ExtractionRankSupport.rankBudgetProjector D k s ∈ ExtractionSchur.permutationSpan D k
ExtractionSchur.flatHaarAverage_permutation_cycle_moment (D s k : ℕ) (hsD : s ≤ D) (σ : Equiv.Perm (Fin k)) :
  (ExtractionSchur.copyPermutationMatrix D k σ * ExtractionSchur.flatHaarAverage D s k hsD).trace =
    (↑s ^ k)⁻¹ • ↑s ^ ExtractionSchur.positionCycleCount k σ
ExtractionSchur.flatHaarAverage_finite_gram_solution (D s k : ℕ) (hsD : s ≤ D) :
  ∃ c,
    ExtractionSchur.permutationCombination D k c = ExtractionSchur.flatHaarAverage D s k hsD ∧
      ∀ (σ : Equiv.Perm (Fin k)),
        ∑ τ, c τ * ↑D ^ ExtractionSchur.positionCycleCount k (σ⁻¹ * τ) =
          (↑s ^ k)⁻¹ • ↑s ^ ExtractionSchur.positionCycleCount k σ⁻¹
ExtractionSchur.flatHaarAverage_eq_combination_iff (D s k : ℕ) (hsD : s ≤ D) (c : Equiv.Perm (Fin k) → ℂ) :
  ExtractionSchur.permutationCombination D k c = ExtractionSchur.flatHaarAverage D s k hsD ↔
    ∀ (σ : Equiv.Perm (Fin k)),
      ∑ τ, c τ * ↑D ^ ExtractionSchur.positionCycleCount k (σ⁻¹ * τ) =
        (↑s ^ k)⁻¹ • ↑s ^ ExtractionSchur.positionCycleCount k σ⁻¹
ExtractionSchur.flatHaarAverage_purity_of_gram_solution (D s k : ℕ) (hsD : s ≤ D) (c : Equiv.Perm (Fin k) → ℂ)
  (hc :
    ∀ (σ : Equiv.Perm (Fin k)),
      ∑ τ, c τ * ↑D ^ ExtractionSchur.positionCycleCount k (σ⁻¹ * τ) =
        (↑s ^ k)⁻¹ • ↑s ^ ExtractionSchur.positionCycleCount k σ⁻¹) :
  (ExtractionSchur.flatHaarAverage D s k hsD * ExtractionSchur.flatHaarAverage D s k hsD).trace =
    ∑ σ, c σ * (↑s ^ k)⁻¹ • ↑s ^ ExtractionSchur.positionCycleCount k σ
