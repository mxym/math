ExtractionSchur.symmetricProjector_eq_copyPermutationAverage (D k : ℕ) :
  SymmetricSupport.symmetricProjector D k = ExtractionSchur.copyPermutationAverage D k
ExtractionSchur.flatHaarAverage_symmetric_block (D s k : ℕ) (hD : 0 < D) (hsD : s ≤ D) :
  ExtractionSchur.flatHaarAverage D s k hsD * SymmetricSupport.symmetricProjector D k =
    ((↑s ^ k)⁻¹ • ↑((s + k - 1).choose k) / ↑((D + k - 1).choose k)) • SymmetricSupport.symmetricProjector D k
ExtractionSchur.flatHaarAverage_one_eq_symmetricState (D k : ℕ) (hD : 0 < D) :
  ExtractionSchur.flatHaarAverage D 1 k ⋯ = SymmetricSupport.symmetricState D k
ExtractionSchur.tensorAntisymmetrizer_rank_choose (D k : ℕ) :
  (ExtractionSchur.tensorAntisymmetrizer D k).rank = D.choose k
ExtractionSchur.alternatingProjector_idempotent (D k : ℕ) :
  ExtractionSchur.alternatingProjector D k * ExtractionSchur.alternatingProjector D k =
    ExtractionSchur.alternatingProjector D k
ExtractionSchur.flatHaarAverage_alternating_block (D s k : ℕ) (hkd : k ≤ D) (hsD : s ≤ D) :
  ExtractionSchur.flatHaarAverage D s k hsD * ExtractionSchur.alternatingProjector D k =
    ((↑s ^ k)⁻¹ • ↑(s.choose k) / ↑(D.choose k)) • ExtractionSchur.alternatingProjector D k
ExtractionSchur.rankBudgetSpace_pred_eq_wedge_kernel (D k : ℕ) (hk : 0 < k) :
  ExtractionRankSupport.rankBudgetSpace D k (k - 1) = (ExtractionSchur.coordinateWedgeMap D k).ker
ExtractionSchur.rankBudgetProjector_boundary_rank (D s : ℕ) :
  (ExtractionRankSupport.rankBudgetProjector D (s + 1) s).rank = D ^ (s + 1) - D.choose (s + 1)
ExtractionSchur.rankBudgetProjector_boundary_eq_complement (D s : ℕ) :
  ExtractionRankSupport.rankBudgetProjector D (s + 1) s = 1 - ExtractionSchur.alternatingProjector D (s + 1)
