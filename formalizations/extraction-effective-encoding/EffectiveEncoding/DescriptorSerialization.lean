import EffectiveEncoding.DescriptorBounds

open CircuitCompletion CircuitRecursion
namespace EffectiveEncoding

/-- Tagged natural-number fields. Wire bounds and CNOT inequalities are
checked by the parser and do not appear as proof objects in the output. -/
def AngleCode.fields (a : AngleCode) : List ℕ :=
  (match a.atom with | .pi => [0] | .merge A B j => [1,A,B,j])++
    [if a.negative then 1 else 0,a.halvings]

def parseAngleFields : List ℕ → Option (AngleCode×List ℕ)
  | 0::0::h::xs => some (⟨.pi,false,h⟩,xs)
  | 0::1::h::xs => some (⟨.pi,true,h⟩,xs)
  | 1::A::B::j::0::h::xs => some (⟨.merge A B j,false,h⟩,xs)
  | 1::A::B::j::1::h::xs => some (⟨.merge A B j,true,h⟩,xs)
  | _ => none

theorem AngleCode.fields_roundtrip (a : AngleCode) (xs : List ℕ) :
    parseAngleFields (a.fields++xs)=some (a,xs) := by
  rcases a with ⟨atom,negative,halvings⟩
  cases atom <;> cases negative <;> rfl

def SingleCode.fields : SingleCode → List ℕ
  | .hadamard => [0]
  | .yBasis => [1]
  | .phase a b => 2::(a.fields++b.fields)
  | .inverse u => 3::u.fields

/-- The fuel is a finite syntax-depth limit, never a semantic real-oracle
parameter. The actual compiler needs only fuel 2. -/
def parseSingleFields : ℕ → List ℕ → Option (SingleCode×List ℕ)
  | 0,_ => none
  | _+1,0::xs => some (.hadamard,xs)
  | _+1,1::xs => some (.yBasis,xs)
  | _+1,2::xs => do
      let (a,ys) ← parseAngleFields xs
      let (b,zs) ← parseAngleFields ys
      some (.phase a b,zs)
  | fuel+1,3::xs => do
      let (u,ys) ← parseSingleFields fuel xs
      some (.inverse u,ys)
  | _,_ => none

theorem SingleCode.fields_roundtrip (u : SingleCode) (fuel : ℕ)
    (hf : u.inverseDepth+1≤fuel) (xs : List ℕ) :
    parseSingleFields fuel (u.fields++xs)=some (u,xs) := by
  induction u generalizing fuel xs with
  | hadamard =>
    cases fuel with
    | zero => simp [inverseDepth] at hf
    | succ fuel => rfl
  | yBasis =>
    cases fuel with
    | zero => simp [inverseDepth] at hf
    | succ fuel => rfl
  | phase a b =>
    cases fuel with
    | zero => simp [inverseDepth] at hf
    | succ fuel => simp [fields,parseSingleFields,List.append_assoc,AngleCode.fields_roundtrip]
  | inverse u ih =>
    cases fuel with
    | zero => simp [inverseDepth] at hf
    | succ fuel =>
      have hu : u.inverseDepth+1≤fuel := by simp only [inverseDepth] at hf;omega
      simp only [fields,List.cons_append,parseSingleFields,ih fuel hu xs,Option.bind_some]
      rfl

def GateCode.fields {n : ℕ} : GateCode n → List ℕ
  | .single i u => 0::i.val::u.fields
  | .cnot c t _ => [1,c.val,t.val]

def parseGateFields (n fuel : ℕ) : List ℕ → Option (GateCode n×List ℕ)
  | 0::i::xs =>
      if hi : i<n then do
        let (u,ys) ← parseSingleFields fuel xs
        some (.single ⟨i,hi⟩ u,ys)
      else none
  | 1::c::t::xs =>
      if hc : c<n then if ht : t<n then
        if he : c=t then none else
          some (.cnot ⟨c,hc⟩ ⟨t,ht⟩ (fun h => he (congrArg Fin.val h)),xs)
      else none else none
  | _ => none

theorem GateCode.fields_roundtrip {n M H D : ℕ} (g : GateCode n) (h : g.Fits M H D)
    (fuel : ℕ) (hf : D+1≤fuel) (xs : List ℕ) :
    parseGateFields n fuel (g.fields++xs)=some (g,xs) := by
  cases g with
  | single i u =>
    have hu : u.inverseDepth+1≤fuel := by have hd:=h.2;omega
    simp [fields,parseGateFields,i.isLt,u.fields_roundtrip fuel hu xs]
  | cnot c t hct =>
    have hc : c.val≠t.val := fun he => hct (Fin.ext he)
    simp [fields,parseGateFields,c.isLt,t.isLt,hc]

def wordFields {n : ℕ} (w : WordCode n) : List ℕ := w.flatMap GateCode.fields

def parseWordFields (n fuel : ℕ) : ℕ → List ℕ → Option (WordCode n×List ℕ)
  | 0,xs => some ([],xs)
  | count+1,xs => do
      let (g,ys) ← parseGateFields n fuel xs
      let (w,zs) ← parseWordFields n fuel count ys
      some (g::w,zs)

theorem wordFields_roundtrip {n M H D : ℕ} (w : WordCode n) (h : WordFits M H D w)
    (fuel : ℕ) (hf : D+1≤fuel) (xs : List ℕ) :
    parseWordFields n fuel w.length (wordFields w++xs)=some (w,xs) := by
  induction w generalizing xs with
  | nil => rfl
  | cons g gs ih =>
    have hg := h g (by simp)
    have hs : WordFits M H D gs := fun a ha => h a (by simp [ha])
    simp only [wordFields,List.flatMap_cons,List.length_cons,List.append_assoc,parseWordFields,
      g.fields_roundtrip hg fuel hf,Option.bind_some]
    change (do
      let (w,zs) ← parseWordFields n fuel gs.length (wordFields gs++xs)
      some (g::w,zs))=some (g::gs,xs)
    rw [ih hs xs]
    rfl

/-- Serialized programs contain their gate count. Depth-2 parsing is enough
for all programs generated by the extraction compiler. -/
def programFields {n : ℕ} (w : WordCode n) : List ℕ := w.length::wordFields w

def parseProgramFields (n : ℕ) : List ℕ → Option (WordCode n×List ℕ)
  | count::xs => parseWordFields n 2 count xs
  | [] => none

theorem extractionCode_fields_roundtrip (k : ℕ) (xs : List ℕ) :
    parseProgramFields (originalWireCount k) (programFields (extractionCode k)++xs)=
      some (extractionCode k,xs) := by
  simpa only [programFields,List.cons_append,parseProgramFields] using
    wordFields_roundtrip (extractionCode k) (extractionCode_fits k) 2 (by decide) xs

theorem AngleCode.fields_length (a : AngleCode) : a.fields.length≤6 := by
  cases he : a.atom <;> simp [fields,he]

theorem SingleCode.fields_length (u : SingleCode) : u.fields.length≤13+u.inverseDepth := by
  induction u with
  | hadamard => simp [fields,inverseDepth]
  | yBasis => simp [fields,inverseDepth]
  | phase a b =>
    have ha := a.fields_length
    have hb := b.fields_length
    simp only [fields,List.length_cons,List.length_append,inverseDepth]
    omega
  | inverse u ih =>
    simp only [fields,List.length_cons,inverseDepth]
    omega

theorem GateCode.fields_length {n M H D : ℕ} (g : GateCode n) (h : g.Fits M H D) :
    g.fields.length≤15+D := by
  cases g with
  | single i u =>
    have hu := u.fields_length
    have hd := h.2
    simp only [fields,List.length_cons]
    omega
  | cnot c t hc => simp [fields];omega

theorem wordFields_length {n M H D : ℕ} (w : WordCode n) (h : WordFits M H D w) :
    (wordFields w).length≤w.length*(15+D) := by
  rw [wordFields,List.length_flatMap]
  calc
    _ ≤ (w.map (fun _ => 15+D)).sum := by
      apply List.sum_le_sum
      intro g hg
      exact g.fields_length (h g hg)
    _ = _ := by simp

theorem extractionCode_fields_length (k : ℕ) :
    (programFields (extractionCode k)).length≤16*(extractionCode k).length+1 := by
  have h := wordFields_length (extractionCode k) (extractionCode_fits k)
  simp only [programFields,List.length_cons]
  omega

end EffectiveEncoding
