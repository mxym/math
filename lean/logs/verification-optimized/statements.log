  (hnonneg : ∀ (i j : ι), 0 ≤ W i j) (hsum : ∀ (j : ι), ∑ i : ι, W i j = 1) (δ : ℝ) (hδ0 : 0 ≤ δ) (hδ : δ ≤ 1 / 8)
  (hdet : 1 - δ ≤ |W.det|) :
  ∃ (σ : Equiv.Perm ι), ∀ (j : ι), 1 - 2 * δ ≤ W (σ j) j ∧ ∑ i : ι, |W i j - if i = σ j then 1 else 0| ≤ 4 * δ
Mxym.StochasticRigidity.exact_permutation.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι] (W : Matrix ι ι ℝ)
  (hnonneg : ∀ (i j : ι), 0 ≤ W i j) (hsum : ∀ (j : ι), ∑ i : ι, W i j = 1) (hdet : 1 ≤ |W.det|) :
  ∃ (σ : Equiv.Perm ι), ∀ (i j : ι), W i j = if i = σ j then 1 else 0
OAI.Paper092.twice_sum_negative_eq_sum_abs.{uι} {ι : Type uι} [Fintype ι] (v : ι → ℝ) (hv : ∑ i : ι, v i = 0) :
  2 * ∑ i : { i : ι // v i < 0 }, -v ↑i = ∑ i : ι, |v i|
OAI.Paper092.simplex_constant_product_ratio (r s : ℕ) (hr : 0 < r) (hs : 0 < s) :
  OAI.Paper092.simplexConstant r * OAI.Paper092.simplexConstant s / OAI.Paper092.simplexConstant (r + s) =
    (↑r + 1) * (↑s + 1) / (↑r + ↑s + 1) * ↑((r + s).choose r) * (↑r ^ r * ↑s ^ s / ↑(r + s) ^ (r + s))
OAI.Paper092.dimension_twenty_ratio :
  OAI.Paper092.simplexConstant 10 * OAI.Paper092.simplexConstant 10 / OAI.Paper092.simplexConstant 20 =
    22355476 / 22020096
OAI.Paper092.dimension_twenty_strict :
  OAI.Paper092.simplexConstant 20 < OAI.Paper092.simplexConstant 10 * OAI.Paper092.simplexConstant 10
Entry005.euclidean_unit_ball_cube (m : ℕ) (hm : 1 ≤ m) :
  ENNReal.ofReal ((2 / ↑m) ^ m) ≤ MeasureTheory.volume (Metric.closedBall 0 1)
Entry005.unit_ball_cube.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E] (hm : 1 ≤ Module.finrank ℝ E) :
  ENNReal.ofReal ((2 / ↑(Module.finrank ℝ E)) ^ Module.finrank ℝ E) ≤ MeasureTheory.volume (Metric.closedBall 0 1)
Entry005.closest_support.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] (K : Set E)
  (hK : Convex ℝ K) (hc : IsComplete K) (hne : K.Nonempty) (q : E) (hq : q ∉ K) :
  ∃ k ∈ K,
    ∃ (n : E),
      0 < ‖q - k‖ ∧
        ‖n‖ = 1 ∧
          inner ℝ n q - inner ℝ n k = ‖q - k‖ ∧ (∀ x ∈ K, inner ℝ n x ≤ inner ℝ n k) ∧ ∀ x ∈ K, ‖q - k‖ ≤ ‖q - x‖
Entry005.cap_ball.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] (K P : Set E) (n q k : E)
  (M s : ℝ) (hP : Convex ℝ P) (hball : Metric.closedBall 0 1 ⊆ P) (hq : q ∈ P) (hn : ‖n‖ = 1) (hM : 0 ≤ M)
  (hqM : ‖q‖ ≤ M) (hs : 0 < s) (hsM : s ≤ M) (hgap : inner ℝ n q - inner ℝ n k = s)
  (hsep : ∀ x ∈ K, inner ℝ n x ≤ inner ℝ n k) :
  have τ := s / (2 * (M + 1));
  Metric.closedBall ((1 - τ) • q) τ ⊆ P ∧ Disjoint K (Metric.closedBall ((1 - τ) • q) τ)
Entry005.cap_measure_gain.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] (μ : MeasureTheory.Measure E) [μ.IsAddHaarMeasure] (K P : Set E) (n q k : E)
  (M s : ℝ) (hKP : K ⊆ P) (hP : Convex ℝ P) (hball : Metric.closedBall 0 1 ⊆ P) (hq : q ∈ P) (hn : ‖n‖ = 1) (hM : 0 ≤ M)
  (hqM : ‖q‖ ≤ M) (hs : 0 < s) (hsM : s ≤ M) (hgap : inner ℝ n q - inner ℝ n k = s)
  (hsep : ∀ x ∈ K, inner ℝ n x ≤ inner ℝ n k) :
  μ K + ENNReal.ofReal ((s / (2 * (M + 1))) ^ Module.finrank ℝ E) * μ (Metric.closedBall 0 1) ≤ μ P
Entry005.nested_body_cap_gain.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] (μ : MeasureTheory.Measure E) [μ.IsAddHaarMeasure] (K P : ConvexBody E) (M : ℝ)
  (hM : 0 ≤ M) (hball : Metric.closedBall 0 1 ⊆ ↑K) (hKP : K ≤ P) (hPM : ↑P ⊆ Metric.closedBall 0 M) (q : E)
  (hq : q ∈ P) (hqK : q ∉ K) :
  ∃ k ∈ K,
    (∀ x ∈ K, ‖q - k‖ ≤ ‖q - x‖) ∧
      μ ↑K + ENNReal.ofReal ((‖q - k‖ / (2 * (M + 1))) ^ Module.finrank ℝ E) * μ (Metric.closedBall 0 1) ≤ μ ↑P
