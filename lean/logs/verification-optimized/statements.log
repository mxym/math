Entry005.project_body_mono.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  (U : Submodule ℝ E) (K P : ConvexBody E) (h : K ≤ P) : Entry005.projectBody U K ≤ Entry005.projectBody U P
Entry005.project_body_unit_ball.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] (U : Submodule ℝ E) (K : ConvexBody E) (hball : Metric.closedBall 0 1 ⊆ ↑K) :
  Metric.closedBall 0 1 ⊆ ↑(Entry005.projectBody U K)
Entry005.project_body_outer_ball.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] (U : Submodule ℝ E) (P : ConvexBody E) (M : ℝ) (hPM : ↑P ⊆ Metric.closedBall 0 M) :
  ↑(Entry005.projectBody U P) ⊆ Metric.closedBall 0 M
Entry005.inner_project.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  (U : Submodule ℝ E) (n : E) (hnU : n ∈ U) (x : E) : inner ℝ ⟨n, hnU⟩ (U.orthogonalProjectionOnto x) = inner ℝ n x
Entry005.exists_perpendicular_unit.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] (hd : 2 ≤ Module.finrank ℝ E) (n : E) (hn : ‖n‖ = 1) : ∃ (u : E), ‖u‖ = 1 ∧ inner ℝ u n = 0
Entry005.hyperplane_dimension.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] (u : E) (hu : ‖u‖ = 1) : Module.finrank ℝ ↥(ℝ ∙ u)ᗮ = Module.finrank ℝ E - 1
Entry005.projection_cap_gain.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E] (K P : ConvexBody E) (U : Submodule ℝ E) (M : ℝ) (hM : 0 ≤ M)
  (hball : Metric.closedBall 0 1 ⊆ ↑K) (hKP : K ≤ P) (hPM : ↑P ⊆ Metric.closedBall 0 M) (q k n : E) (hq : q ∈ P)
  (hn : ‖n‖ = 1) (hnU : n ∈ U) (hs : 0 < ‖q - k‖) (hsM : ‖q - k‖ ≤ M) (hgap : inner ℝ n q - inner ℝ n k = ‖q - k‖)
  (hsep : ∀ x ∈ K, inner ℝ n x ≤ inner ℝ n k) :
  Entry005.projectedVolume U K +
      ENNReal.ofReal ((‖q - k‖ / (2 * (M + 1))) ^ Module.finrank ℝ ↥U) * MeasureTheory.volume (Metric.closedBall 0 1) ≤
    Entry005.projectedVolume U P
Entry005.projection_cap_cube_gain.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] (K P : ConvexBody E) (U : Submodule ℝ E)
  (hm : 1 ≤ Module.finrank ℝ ↥U) (M : ℝ) (hM : 0 ≤ M) (hball : Metric.closedBall 0 1 ⊆ ↑K) (hKP : K ≤ P)
  (hPM : ↑P ⊆ Metric.closedBall 0 M) (q k n : E) (hq : q ∈ P) (hn : ‖n‖ = 1) (hnU : n ∈ U) (hs : 0 < ‖q - k‖)
  (hsM : ‖q - k‖ ≤ M) (hgap : inner ℝ n q - inner ℝ n k = ‖q - k‖) (hsep : ∀ x ∈ K, inner ℝ n x ≤ inner ℝ n k) :
  Entry005.projectedVolume U K + ENNReal.ofReal ((‖q - k‖ / (↑(Module.finrank ℝ ↥U) * (M + 1))) ^ Module.finrank ℝ ↥U) ≤
    Entry005.projectedVolume U P
Entry005.exists_projection_cap.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] (hd : 2 ≤ Module.finrank ℝ E) (K P : ConvexBody E) (M : ℝ)
  (hM : 0 ≤ M) (hball : Metric.closedBall 0 1 ⊆ ↑K) (hKP : K ≤ P) (hPM : ↑P ⊆ Metric.closedBall 0 M) (q : E)
  (hq : q ∈ P) (hqK : q ∉ K) :
  ∃ k ∈ K,
    ∃ (u : E),
      ‖u‖ = 1 ∧
        (∀ x ∈ K, ‖q - k‖ ≤ ‖q - x‖) ∧
          Entry005.projectedVolume (ℝ ∙ u)ᗮ K +
              ENNReal.ofReal ((‖q - k‖ / (↑(Module.finrank ℝ E - 1) * (M + 1))) ^ (Module.finrank ℝ E - 1)) ≤
            Entry005.projectedVolume (ℝ ∙ u)ᗮ P
Entry005.hausdorff_from_projection_deficit.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] (hd : 2 ≤ Module.finrank ℝ E) (K P : ConvexBody E)
  (M η : ℝ) (hM : 0 ≤ M) (hη : 0 ≤ η) (hball : Metric.closedBall 0 1 ⊆ ↑K) (hKP : K ≤ P)
  (hPM : ↑P ⊆ Metric.closedBall 0 M)
  (hdef :
    ∀ (u : E),
      ‖u‖ = 1 → (Entry005.projectedVolume (ℝ ∙ u)ᗮ P).toReal - (Entry005.projectedVolume (ℝ ∙ u)ᗮ K).toReal ≤ η) :
  Metric.hausdorffDist ↑K ↑P ≤ ↑(Module.finrank ℝ E - 1) * (M + 1) * η ^ (1 / ↑(Module.finrank ℝ E - 1))
